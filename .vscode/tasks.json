{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build SITEPASS frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build",
				"--prefix",
				"Frontend"
			],
			"problemMatcher": []
		},
		{
			"label": "Preview SITEPASS frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--prefix",
				"Frontend",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run SITEPASS backend",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--prefix",
				"Backend/sitepass-backend"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}