# Production template. Copy to .env on the backend host and fill in secrets.
# For local development, use NODE_ENV=development and your local frontend URL.
NODE_ENV=production
PORT=5001
# Same-server Nginx setup. For App Platform, use HOST=0.0.0.0 and its assigned port.
HOST=127.0.0.1
# Trust only the local Nginx proxy. Configure exact proxy subnets for other hosting.
TRUST_PROXY=loopback
FRONTEND_URL=https://qrsystem.com
SITE_TIMEZONE=Asia/Colombo

# MySQL on the same server. Replace the host/port if your database is elsewhere.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=sitepass_user
DATABASE_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DATABASE_NAME=sitepass_db

# For managed MySQL, enable TLS and supply the provider's CA certificate path.
DATABASE_SSL=false
# DATABASE_SSL_CA_PATH=/etc/sitepass/mysql-ca.crt
# Needed only for a trusted local MySQL 8 connection that uses RSA password
# authentication without TLS. Leave false for remote/production databases.
DATABASE_ALLOW_PUBLIC_KEY_RETRIEVAL=false
# Prisma CLI uses TLS options in DATABASE_URL separately; see deployment guide.

# Prisma CLI: use the same database credentials as above.
# URL-encode special characters in the URL password; keep DATABASE_PASSWORD raw.
DATABASE_URL=mysql://sitepass_user:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:3306/sitepass_db
# Optional for local development only; omit in production.
# Use a separate database, never the application database.
# SHADOW_DATABASE_URL=mysql://sitepass_user:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:3306/sitepass_shadow

# Required: fill with a cryptographically random secret of at least 32 characters.
JWT_SECRET=

# Required for email delivery. Use your Brevo API key and verified sender address.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@qrsystem.com
BREVO_SENDER_NAME=SITEPASS

# Optional: select an existing site by its code; otherwise the earliest site is used.
# SITEPASS_SITE_CODE=YOUR_EXISTING_SITE_CODE
