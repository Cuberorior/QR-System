{
  "name": "sitepass-backend",
  "version": "1.0.0",
  "description": "SITEPASS QR-Based Construction Site Entry and Exit Verification Backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "prisma generate && tsc --noEmit",
    "bootstrap:dev-admin": "tsx scripts/bootstrap-dev-admin.ts",
    "email:test": "tsx scripts/test-brevo-email.ts",
    "email:preview": "tsx scripts/preview-welcome-email.ts",
    "test:email-service": "tsx scripts/test-brevo-email-service.ts",
    "test:integration": "tsx scripts/test-backend-integration.ts",
    "test:management": "tsx scripts/test-management-api.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "keywords": [
    "sitepass",
    "construction",
    "attendance",
    "qr-code"
  ],
  "author": "AppZ Makers",
  "license": "ISC",
