generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model ConstructionSite {
  id                String   @id @default(cuid())
  siteCode          String   @unique
  name              String
  location          String?
  latitude          Float?
  longitude         Float?
  geofenceRadius    Int      @default(100)
  geofencingEnabled Boolean  @default(true)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  employees            Employee[]
  attendanceRecords    AttendanceRecord[]
  visitorVisits        VisitorVisit[]
  verificationSessions VerificationSession[]
  adminAssignments     AdminSiteAssignment[]
  safetyDeclarations   SafetyDeclaration[]
}

enum AdminRole {
  ADMIN
}

enum AttendanceStatus {
  OPEN
  CLOSED
}

enum VisitorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VisitStatus {
  REGISTERED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

model Administrator {
  id           String    @id @default(cuid())
  fullName     String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  siteAssignments AdminSiteAssignment[]
}

model AdminSiteAssignment {
  id        String   @id @default(cuid())
  adminId   String
  siteId    String
  createdAt DateTime @default(now())

  admin Administrator    @relation(fields: [adminId], references: [id])
  site  ConstructionSite @relation(fields: [siteId], references: [id])

  @@unique([adminId, siteId])
}

model Employee {
  id             String   @id @default(cuid())
  employeeCode   String   @unique
  fullName       String
  email          String?
  phone          String?
  accessCodeHash String
  siteId         String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site              ConstructionSite   @relation(fields: [siteId], references: [id])
  attendanceRecords AttendanceRecord[]
  emailDeliveries   EmailDelivery[]
  creationRequest   EmployeeCreationRequest?
  safetyDeclarations SafetyDeclaration[]

  @@index([siteId])
}

model EmployeeIdSequence {
  id        Int      @id
  nextValue Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
  BOUNCED
}

model EmailDelivery {
  id             String              @id @default(cuid())
  employeeId     String?
  visitorVisitId String?
  recipientEmail String
  emailType      String
  status         EmailDeliveryStatus @default(PENDING)
  brevoMessageId String?
  attemptCount   Int                 @default(0)
  nextRetryAt    DateTime?
  lastError      String?             @db.VarChar(500)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  employee     Employee?     @relation(fields: [employeeId], references: [id])
  visitorVisit VisitorVisit? @relation(fields: [visitorVisitId], references: [id])

  @@index([employeeId, createdAt])
  @@index([status, nextRetryAt])
  @@index([visitorVisitId, createdAt])
}

model EmployeeCreationRequest {
  idempotencyKey String   @id
  employeeId     String   @unique
  createdAt      DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  employeeId String
  siteId     String
  entryTime  DateTime         @default(now())
  exitTime   DateTime?
  status     AttendanceStatus @default(OPEN)
  createdAt  DateTime         @default(now())

  employee Employee         @relation(fields: [employeeId], references: [id])
  site     ConstructionSite @relation(fields: [siteId], references: [id])
  safetyDeclaration SafetyDeclaration?

  @@index([employeeId, entryTime])
  @@index([siteId, entryTime])
}

enum SafetyDeclarationStatus {
  DECLARED
  CONSUMED
  EXPIRED
  REVOKED
}

model SafetyDeclaration {
  id                  String                  @id @default(cuid())
  siteId              String
  employeeId          String?
  attendanceRecordId  String?                 @unique
  checklistVersion    String
  intendedAction      String                  @default("ENTRY")
  responseSnapshot    Json
  submittedAt         DateTime
  consumedAt          DateTime?
  tokenHash           String                  @unique
  tokenExpiresAt      DateTime
  status              SafetyDeclarationStatus @default(DECLARED)
  createdAt           DateTime                @default(now())

  site             ConstructionSite @relation(fields: [siteId], references: [id])
  employee         Employee?        @relation(fields: [employeeId], references: [id])
  attendanceRecord AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id])

  @@index([siteId, status])
  @@index([employeeId, createdAt])
  @@index([tokenExpiresAt])
}

model Visitor {
  id           String   @id @default(cuid())
  visitorCode  String?  @unique
  fullName     String
  phone        String
  email        String?
  organization String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  visits VisitorVisit[]
}

model VisitorVisit {
  id                         String                @id @default(cuid())
  visitorId                  String
  siteId                     String
  purpose                    String
  approvalStatus             VisitorApprovalStatus @default(PENDING)
  visitStatus                VisitStatus           @default(REGISTERED)
  entryTime                  DateTime?
  exitTime                   DateTime?
  accessCodeHash             String?
  credentialExpiresAt        DateTime?
  emailVerifiedAt            DateTime?
  emailVerificationTokenHash String?               @unique
  emailVerificationExpiresAt DateTime?
  revokedAt                  DateTime?
  idempotencyKey             String?               @unique
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  authorizationTokenHash   String?     @unique
  authorizationExpiresAt   DateTime?

  visitor Visitor          @relation(fields: [visitorId], references: [id])
  site    ConstructionSite @relation(fields: [siteId], references: [id])
  emailDeliveries EmailDelivery[]

  @@index([siteId, approvalStatus])
  @@index([siteId, visitStatus])
  @@index([credentialExpiresAt])
}

model VisitorIdSequence {
  id        Int      @id
  nextValue Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationSession {
  id         String    @id @default(cuid())
  siteId     String
  tokenHash  String    @unique
  latitude   Float
  longitude  Float
  accuracy   Float?
  intendedAction String    @default("LEGACY")
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  site ConstructionSite @relation(fields: [siteId], references: [id])

  @@index([siteId, expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorType  String
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
